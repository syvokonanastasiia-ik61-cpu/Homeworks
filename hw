import itertools

#Завдання 1
#f(1110 1100 1111 1001)

print("Завдання 1.1")

f_vec = "1110110011111001"
def f(x, y, z, w):
    return int(f_vec[(x<< 3) | (y << 2) | (z<<1) | w])

pdnf = []
pknf = []

var = ['x', 'y', 'z', 'w']

print("x | y | z | w | f")
for x, y, z, w in itertools.product([0, 1], repeat=4):
    val = f(x, y, z, w)
    print(f"{x} | {y} | {z} | {w} | {val}")

    term = (x, y, z, w)
    if val==1:
        pdnf.append(term)
    else:
        pknf.append(term)

print("-" * 40)

print("\nДДНФ:", pdnf)

dnf_parts = []
for t in pdnf:
    literals = [v if b == 1 else "¬" + v for v, b in zip(var, t)]
    dnf_parts.append("(" + "·".join(literals) + ")")

dnf = " + ".join(dnf_parts)
print("\nДДНФ:\n", dnf)


knf_parts = []
for t in pknf:
    literals = [v if b == 0 else "¬" + v for v, b in zip(var, t)]  # ← навпаки!
    knf_parts.append("(" + " + ".join(literals) + ")")

knf = " · ".join(knf_parts)

print("\nДКНФ:\n", knf)


