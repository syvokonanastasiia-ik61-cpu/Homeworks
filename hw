print("Завдання 4")

task4_set = [0, 2, 4, 6, 8, 10, 12, 14]
task4_vars = ['x', 'y', 'z', 't']

def f_task4(set, var):

    pdnf_4 = []
    pknf_4 = []
    print("x | y | z | t | f")

    for term in itertools.product([0, 1], repeat=4):
        index = int("".join(map(str, term)), 2)
        val = 1 if index in set else 0
        print(f"{'|'.join(map(str, term))} | {val}")

        if val == 1:
            pdnf_4.append(term)
        else:
            pknf_4.append(term)

    print("-" * 40)

    dnf4_parts = []
    for t in pdnf_4:
        literals = [v if b == 1 else "¬" + v for v, b in zip(var, t)]
        dnf4_parts.append("(" + "·".join(literals) + ")")

    dnf4 = " + ".join(dnf4_parts)

    knf4_parts = []
    for t in pknf_4:
        literals = [v if b == 0 else "¬" + v for v, b in zip(var, t)]  # ← навпаки!
        knf4_parts.append("(" + " + ".join(literals) + ")")

    knf4 = " · ".join(knf4_parts)

    return dnf4, knf4


dnf4, knf4 = f_task4(task4_set, task4_vars)

print("\nДДНФ:\n", dnf4)
print("\nДДНФ:\n", knf4)
